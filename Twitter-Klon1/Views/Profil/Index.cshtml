@model IEnumerable<Twitter_Klon1.Models.Beitrag>

@{
    ViewData["Title"] = "Mein Profil";
}

<h1>Mein Profil</h1>

<form asp-action="Index" method="get">
    <input type="text"
           name="suche"
           placeholder="Beiträge suchen..."
           value="@Context.Request.Query["suche"]" />

    <button type="submit">Suchen</button>
</form>

<hr />

@foreach (var item in Model)
{
    <div class="card mb-3">
        <div class="card-body">

            <p>@item.Textinhalt</p>

            <p>
                Erstellt am: @item.ErstellungsDatum
            </p>

            <p>
                ❤️ @item.Likes.Count
            </p>

            <a asp-controller="Beitrags"
               asp-action="Edit"
               asp-route-id="@item.Id"
               class="btn btn-primary">
                Bearbeiten
            </a>

            <a asp-controller="Beitrags"
               asp-action="Delete"
               asp-route-id="@item.Id"
               class="btn btn-danger">
                Löschen
            </a>

        </div>
    </div>
}
